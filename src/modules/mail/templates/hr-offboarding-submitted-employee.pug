doctype html
html(lang="en")
  body(style="font-family: Arial, sans-serif; color: #1f2937;")
    h2 Offboarding started
    p Hello #{employeeName},
    p Your offboarding request has been submitted and is under review.
    if exitDate
      p Exit date: #{exitDate}
    p
      a(href=reviewUrl) Track offboarding
    p #{appName}

