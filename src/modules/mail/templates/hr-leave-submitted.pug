doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Leave approval required
  body(style="margin:0; padding:0; background:#f5f5f5; color:#242424; font-family:Arial, Helvetica, sans-serif;")
    table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f5f5f5;")
      tr
        td(align="center" style="padding:32px 16px;")
          table(role="presentation" width="640" cellspacing="0" cellpadding="0" border="0" style="width:100%; max-width:640px; background:#ffffff; border:1px solid #e1dfdd; border-radius:12px; overflow:hidden;")
            tr
              td(style="padding:28px 36px 22px; text-align:center; border-bottom:1px solid #edebe9;")
                div(style="font-size:26px; line-height:32px; font-weight:700; color:#242424;") #{appName}
                div(style="padding-top:12px; font-size:0;")
                  span(style="display:inline-block; width:10px; height:10px; margin:0 5px; border-radius:50%; background:#4f6bed;")
                  span(style="display:inline-block; width:10px; height:10px; margin:0 5px; border-radius:50%; background:#10b981;")
                  span(style="display:inline-block; width:10px; height:10px; margin:0 5px; border-radius:50%; background:#f5c542;")
            tr
              td(style="padding:32px 36px;")
                p(style="margin:0 0 8px; font-size:16px; line-height:24px;") Hello #{approverName},
                h1(style="margin:0 0 22px; font-size:22px; line-height:30px; font-weight:700;") Your approval is required
                p(style="margin:0 0 24px; font-size:16px; line-height:25px; color:#424242;")
                  strong #{employeeName}
                  |  submitted a leave request for your review.
                table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 26px; border:1px solid #e1dfdd; border-radius:8px; background:#faf9f8;")
                  tr
                    td(style="padding:18px 20px;")
                      table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0")
                        tr
                          td(style="padding:4px 12px 4px 0; color:#616161; font-size:14px; line-height:21px;") Leave type
                          td(style="padding:4px 0; text-align:right; font-size:14px; line-height:21px; font-weight:600;") #{leaveTypeName}
                        tr
                          td(style="padding:4px 12px 4px 0; color:#616161; font-size:14px; line-height:21px;") Dates
                          td(style="padding:4px 0; text-align:right; font-size:14px; line-height:21px; font-weight:600;") #{startDate} – #{endDate}
                        tr
                          td(style="padding:4px 12px 4px 0; color:#616161; font-size:14px; line-height:21px;") Duration
                          td(style="padding:4px 0; text-align:right; font-size:14px; line-height:21px; font-weight:600;") #{totalDays} working day(s)
                        if reason
                          tr
                            td(style="padding:4px 12px 4px 0; color:#616161; font-size:14px; line-height:21px; vertical-align:top;") Reason
                            td(style="padding:4px 0; text-align:right; font-size:14px; line-height:21px; font-weight:600;") #{reason}
                table(role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:0 auto 22px;")
                  tr
                    td(style="border-radius:6px; background:#4f46b8;")
                      a(href=reviewUrl style="display:inline-block; padding:13px 24px; color:#ffffff; font-size:16px; line-height:20px; font-weight:700; text-decoration:none;") Review leave request
                p(style="margin:0; text-align:center; color:#616161; font-size:13px; line-height:20px;") Sign in securely to approve, reject, or return this request for correction.
            tr
              td(style="padding:22px 36px; text-align:center; background:#faf9f8; border-top:1px solid #edebe9;")
                p(style="margin:0 0 6px; color:#616161; font-size:12px; line-height:18px;") This email was sent to #{recipientEmail}.
                p(style="margin:0; color:#8a8886; font-size:12px; line-height:18px;") © #{year} #{appName} · Need help? #{supportEmail}

