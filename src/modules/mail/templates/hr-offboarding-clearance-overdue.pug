doctype html
html(lang="en")
  body(style="font-family: Arial, sans-serif; color: #1f2937;")
    h2 Offboarding clearance overdue
    p Hello #{ownerName || 'Team member'},
    p The #{clearanceType} clearance for #{employeeName} is overdue.
    if exitDate
      p Exit date: #{exitDate}
    if dueDate
      p Due date: #{dueDate}
    p
      a(href=clearanceUrl) Open clearance queue in the app
    p #{appName}
