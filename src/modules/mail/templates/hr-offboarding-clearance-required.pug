doctype html
html(lang="en")
  body(style="font-family: Arial, sans-serif; color: #1f2937;")
    h2 Clearance required
    p Hello #{ownerName},
    p A #{clearanceType} clearance is pending for #{employeeName}.
    if exitDate
      p Exit date: #{exitDate}
    p
      a(href=clearanceUrl) Open clearance
    p #{appName}

