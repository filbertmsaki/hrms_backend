doctype html
html(lang="en")
  body(style="font-family: Arial, sans-serif; color: #1f2937;")
    h2 Offboarding task overdue
    p Hello #{assigneeName || 'Team member'},
    p The offboarding task "#{taskTitle}" for #{employeeName} is overdue.
    if exitDate
      p Exit date: #{exitDate}
    if dueDate
      p Due date: #{dueDate}
    p
      a(href=taskUrl) Open task queue in the app
    p #{appName}
