doctype html
html(lang="en")
  body(style="font-family: Arial, sans-serif; color: #1f2937;")
    h2= heading
    p Hello #{recipientName},
    each line in lines
      p= line
    if code
      p(style="font-size: 28px; letter-spacing: 6px; font-weight: bold;")= code
      p(style="font-size: 12px; color: #6b7280;") This code expires in 10 minutes. Never share it with anyone.
    if actionUrl
      p
        a(href=actionUrl) Open in HRMS
    p #{appName}
