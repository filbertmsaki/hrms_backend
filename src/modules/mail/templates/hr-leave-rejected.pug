doctype html
html(lang="en")
  body(style="font-family: Arial, sans-serif; color: #1f2937;")
    h2 Leave not approved
    p Hello #{employeeName},
    p Your #{leaveTypeName} request was not approved.
    p Dates: #{startDate} to #{endDate}
    if rejectionComments
      p Comments: #{rejectionComments}
    p
      a(href=dashboardUrl) View leave request
    p #{appName}

