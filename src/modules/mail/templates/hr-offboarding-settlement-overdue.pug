doctype html
html(lang="en")
  body(style="font-family: Arial, sans-serif; color: #1f2937;")
    h2 Offboarding settlement overdue
    p Hello #{ownerName || 'Team member'},
    p The settlement item "#{settlementTitle}" for #{employeeName} is overdue.
    if exitDate
      p Exit date: #{exitDate}
    if dueDate
      p Due date: #{dueDate}
    p
      a(href=settlementUrl) Open settlement queue in the app
    p #{appName}
