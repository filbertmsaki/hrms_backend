doctype html
html(lang="en")
  body(style="font-family: Arial, sans-serif; color: #1f2937;")
    h2 Leave request returned for correction
    p Hello #{employeeName},
    p Your #{leaveTypeName} request needs corrections before it can proceed.
    p Dates: #{startDate} to #{endDate}
    if returnReason
      p Reason: #{returnReason}
    p
      a(href=dashboardUrl) View and resubmit leave request
    p #{appName}
