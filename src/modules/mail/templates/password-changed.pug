doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name="color-scheme" content="light")
    meta(name="supported-color-schemes" content="light")
    title Your password was changed
    style.
      @media only screen and (max-width: 640px) {
        .email-wrap { padding: 16px 10px 28px !important; }
        .email-header, .email-body, .email-footer { padding-left: 22px !important; padding-right: 22px !important; }
        .email-title { font-size: 22px !important; }
      }
  body(style="margin:0; padding:0; width:100%; background-color:#f1f5f9; color:#111111; font-family:'Segoe UI', 'Segoe UI Variable', Tahoma, Arial, sans-serif; -webkit-text-size-adjust:100%;")
    div(style="display:none; font-size:1px; color:#f1f5f9; line-height:1px; max-height:0; max-width:0; opacity:0; overflow:hidden;")
      | Your #{appName} password was changed. If this was not you, secure the account.
    table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse; background-color:#f1f5f9;")
      tr
        td.email-wrap(align="center" style="padding:32px 16px 40px;")
          table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:560px; border-collapse:separate; border-spacing:0; background-color:#ffffff; border:1px solid #e5e7eb; border-radius:14px; overflow:hidden;")
            tr
              td.email-header(align="left" bgcolor="#303194" style="padding:28px 32px 26px; background-color:#303194; background-image:linear-gradient(135deg, #303194 0%, #252882 100%); text-align:left;")
                p(style="margin:0; color:#ffffff; font-size:13px; line-height:18px; font-weight:600; letter-spacing:-0.01em;") #{appName}
                h1.email-title(style="margin:18px 0 0; color:#ffffff; font-size:24px; line-height:1.25; font-weight:600; letter-spacing:-0.03em;") Password updated
                p(style="margin:8px 0 0; color:#d1d2ee; font-size:14px; line-height:22px;") This confirms a change on your account.
            tr
              td.email-body(align="left" style="padding:28px 32px 8px; color:#111111; text-align:left;")
                p(style="margin:0 0 14px; font-size:15px; line-height:24px; font-weight:600; color:#111111;") Hello #{name},
                p(style="margin:0 0 14px; font-size:14px; line-height:22px; color:#4b5563;") The password for your #{appName} account was changed on #{changedAt}.
                p(style="margin:0 0 22px; font-size:14px; line-height:22px; color:#4b5563;") If this was you, you can sign in with the new password. Nothing else is required.
            tr
              td(align="left" style="padding:0 32px 28px; text-align:left;")
                table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse; background-color:#f5f5fc; border:1px solid #d1d2ee; border-radius:8px;")
                  tr
                    td(align="left" style="padding:14px 16px; text-align:left;")
                      p(style="margin:0; color:#252882; font-size:13px; line-height:20px;") If you did not change it, reset the password from the sign-in page and tell your HR administrator.
            tr
              td.email-footer(align="left" style="padding:16px 32px 18px; border-top:1px solid #e5e7eb; background-color:#fafafa; text-align:left;")
                p(style="margin:0 0 4px; color:#111111; font-size:12px; line-height:18px; font-weight:600;") © #{year} Alliance Insurance Corporation Ltd
                p(style="margin:0; color:#6b7280; font-size:12px; line-height:18px;") #{appName}. Sent automatically. Please do not reply.
