{
  "metadata": {
    "company_name": "Alliance Insurance Corporation Ltd",
    "timezone": "Africa/Dar_es_Salaam",
    "notes": [
      "This file is Postman-oriented and based on the actual DTOs in the attendance module.",
      "Quoted placeholders such as {{hqBranchId}} and {{weekdayShiftId}} are intentional so the file stays valid JSON in the repository.",
      "The create shift endpoint can create off-like shifts, but employee-specific Saturday rest is better handled with shift schedules or timetable-driven scheduling."
    ]
  },
  "step_by_step_setup": [
    {
      "step": 1,
      "purpose": "Create company-level attendance policy",
      "method": "POST",
      "endpoint": "/attendance/policies",
      "dto": "CreateAttendancePolicyDto",
      "body": {
        "name": "Alliance Standard Attendance Policy",
        "is_active": true,
        "late_after_minutes": 10,
        "half_day_after_minutes": 240,
        "absent_after_minutes": 480,
        "allow_early_checkin": true,
        "allow_late_checkout": true,
        "auto_absent_if_no_checkin": true,
        "requires_manager_approval_for_overtime": false,
        "rounding_mode": "NEAREST",
        "max_missing_punch_allowed": 1,
        "weekend_days": "SUN",
        "auto_mark_weekend_as_off": true,
        "treat_weekend_as_absent_if_scheduled": false,
        "holiday_policy_mode": "OFF",
        "authentication_modes": "MOBILE_APP,WEB,DEVICE",
        "require_geo_fencing": true,
        "allow_multi_device_login": false,
        "auto_calculate_attendance": true,
        "calculation_time": "23:30:00",
        "grace_period_minutes": 10,
        "consider_shift_roster": true,
        "ignore_missing_checkout_if_hours_valid": false
      }
    },
    {
      "step": 2,
      "purpose": "Create company-level attendance setting",
      "method": "POST",
      "endpoint": "/attendance/settings",
      "dto": "CreateAttendanceSettingDto",
      "body": {
        "name": "Alliance Overtime Defaults",
        "overtime_start_after_minutes": 30,
        "max_overtime_minutes_per_day": 180,
        "max_overtime_minutes_per_month": 1800,
        "overtime_rate_multiplier": 1.5,
        "holiday_overtime_multiplier": 2,
        "weekend_overtime_multiplier": 1.75,
        "requires_approval": false,
        "auto_calculate": true
      }
    },
    {
      "step": 3,
      "purpose": "Create reusable shift definitions",
      "method": "POST",
      "endpoint": "/shift/shifts",
      "dto": "CreateShiftDto",
      "payload_group": "create_shift_payloads"
    },
    {
      "step": 4,
      "purpose": "Attach breaks to working shifts",
      "method": "POST",
      "endpoint": "/shift/shift-breaks",
      "dto": "CreateShiftBreakDto",
      "payload_group": "create_shift_break_payloads"
    },
    {
      "step": 5,
      "purpose": "Attach attendance rules to working shifts",
      "method": "POST",
      "endpoint": "/shift/shift-attendance-rules",
      "dto": "CreateShiftAttendanceRuleDto",
      "payload_group": "create_shift_attendance_rule_payloads"
    },
    {
      "step": 6,
      "purpose": "Attach overtime rules to working shifts",
      "method": "POST",
      "endpoint": "/shift/shift-overtime-rules",
      "dto": "CreateShiftOvertimeRuleDto",
      "payload_group": "create_shift_overtime_rule_payloads"
    },
    {
      "step": 7,
      "purpose": "Create a recurring weekly timetable",
      "method": "POST",
      "endpoint": "/timetable/timetables",
      "dto": "CreateTimetableDto",
      "body": {
        "branch_id": "{{hqBranchId}}",
        "name": "Alliance HQ Weekly Attendance Timetable",
        "code": "ALL_HQ_WEEKLY_ATTENDANCE",
        "description": "Base recurring weekly attendance pattern for Alliance HQ staff.",
        "timetable_type": "FIXED",
        "timezone": "Africa/Dar_es_Salaam",
        "is_default": false,
        "status": "ACTIVE"
      }
    },
    {
      "step": 8,
      "purpose": "Map weekdays and weekends in timetable days",
      "method": "POST",
      "endpoint": "/timetable/timetable-days",
      "dto": "CreateTimetableDayDto",
      "payload_group": "create_timetable_day_payloads"
    },
    {
      "step": 9,
      "purpose": "Assign the timetable to employees",
      "method": "POST",
      "endpoint": "/timetable/employee-timetables",
      "dto": "CreateEmployeeTimetableDto",
      "payload_group": "create_employee_timetable_payloads"
    },
    {
      "step": 10,
      "purpose": "Plan monthly Saturday rests per employee as explicit overrides",
      "method": "POST",
      "endpoint": "/shift/shift-schedules",
      "dto": "CreateShiftScheduleDto",
      "payload_group": "create_shift_schedule_override_payloads"
    }
  ],
