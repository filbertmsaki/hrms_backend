# compiled output
/dist/
/node_modules/
/build/
/.claude/
/.agents/
/.codex/
/temp/
/tmp/
/tmp-logs/

# Logs
/logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store
/src/database/migrations/*
!/src/database/migrations/*.ts
!/src/database/migrations/*.js

# Tests
/coverage
/.nyc_output
/test/*
!/test/jest-e2e.json
!/test/*.e2e-spec.ts
!/test/setup-e2e.ts
!/test/helpers/
/test/fixtures/

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.tmp-tsc-check
.tmp-test-logs

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Environment files
/.env
/.env.*
!.env.example

# Runtime uploads
/uploads/
/private-uploads/
/backups/

# Test environment
/.env.test.local
/.env.development.local
/.env.uat.local
/.env.production.local

# temp directory
/.temp/
/.tmp/

# Runtime data
/dump.rdb
/pids/
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Local lint artifacts
lint-report*.json

# Deploy-script-generated rollback pointer (per-environment, written by scripts/deploy-*.sh)
.previous-deploy-sha
.eslintcache
