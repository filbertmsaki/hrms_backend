# =========================================================
# APPLICATION
# =========================================================
NODE_ENV=development
APP_NAME=Alliance HRMS
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8888
APP_GLOBAL_PREFIX=api
APP_TIMEZONE=Africa/Dar_es_Salaam

APP_URL=http://localhost:8888
APP_FRONTEND_URL=http://localhost:9991
SUPPORT_EMAIL=support@example.com

# Comma-separated frontend origins
APP_ALLOWED_ORIGINS=http://localhost:9991,http://127.0.0.1:9991

# Disable in production unless documentation is protected
APP_ENABLE_API_DOCS=true

# Enable when running behind Nginx or another reverse proxy
APP_TRUST_PROXY=true

PORT=8888
TZ=Africa/Dar_es_Salaam
DEFAULT_TIMEZONE=Africa/Dar_es_Salaam

# =========================================================
# FILE STORAGE
# =========================================================
APP_PUBLIC_STORAGE_PATH=uploads
APP_PRIVATE_STORAGE_PATH=private-uploads
MAX_UPLOAD_FILE_SIZE_BYTES=10485760

# =========================================================
# DATABASE
# =========================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-database-password
DB_NAME=hrms_db

# =========================================================
# JWT
# =========================================================
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_RESET_SECRET=replace-with-a-long-random-reset-secret
JWT_ACCESS_EXPIRATION=20m
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=alliance-hrms
JWT_AUDIENCE=alliance-hrms-web

# =========================================================
# ENCRYPTION
# =========================================================
APP_KEY=replace-with-a-long-random-application-key
TWO_FACTOR_SECRET_KEY=replace-with-a-long-random-2fa-secret
ATTENDANCE_DEVICE_SECRET_KEY=replace-with-a-long-random-device-secret
REPORT_SMTP_SECRET_KEY=replace-with-a-long-random-report-smtp-secret
BIOMETRIC_ENCRYPTION_KEY=replace-with-a-long-random-biometric-secret

# =========================================================
# REDIS
# =========================================================
USE_REDIS=true
REDIS_URL=redis://127.0.0.1:6379

# =========================================================
# RATE LIMIT
# =========================================================
THROTTLER_TTL=60000
THROTTLER_LIMIT=100

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=no-reply@example.com
MAIL_PASS=replace-with-smtp-password
MAIL_SECURE=false
MAIL_FROM=no-reply@example.com
MAIL_OVERRIDE_ENABLED=false
MAIL_TEST_TO=test-notifications@example.com
MAIL_TEST_CC=
MAIL_TEST_BCC=
MAIL_OVERRIDE_ADD_ORIGINAL_RECIPIENTS_TO_BODY=true
MAIL_OVERRIDE_SUBJECT_PREFIX=[TEST]

ENABLE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_EXPIRY_HOURS=24
EMPLOYEE_IMPORT_DEFAULT_PASSWORD=
AUTH_REQUIRED_2FA_ROLES=SUPER_ADMIN,PLATFORM_ADMINISTRATOR,COMPANY_ADMIN,HR_MANAGER,IT_ADMIN,AUDITOR

# =========================================================
# EMPLOYEE IMPORT
# =========================================================
EMPLOYEE_IMPORT_MAX_FILE_SIZE_BYTES=10485760
EMPLOYEE_IMPORT_MAX_ROWS=1000
EMPLOYEE_IMPORT_PREVIEW_TTL_MINUTES=30
EMPLOYEE_IMPORT_RETENTION_DAYS=90
EMPLOYEE_IMPORT_QUEUE_CONCURRENCY=1
EMPLOYEE_IMPORT_MAX_ATTEMPTS=3
EMPLOYEE_IMPORT_STALE_MINUTES=30
EMPLOYEE_IMPORT_CREATE_PENDING_USERS=true

# =========================================================
# DOCUMENT MANAGEMENT
# =========================================================
HR_DOCUMENT_MAX_FILE_SIZE_BYTES=10485760
HR_DOCUMENT_RETENTION_DAYS=365
HR_DOCUMENT_DELETE_GRACE_DAYS=30
FILE_MALWARE_SCAN_MODE=optional
FILE_MALWARE_SCAN_COMMAND=clamdscan
FILE_MALWARE_SCAN_TIMEOUT_MS=30000

# =========================================================
# ONBOARDING
# =========================================================
ONBOARDING_ACTIVATION_QUEUE_CONCURRENCY=1
ONBOARDING_ACTIVATION_MAX_ATTEMPTS=5
ONBOARDING_ACTIVATION_RETRY_DELAY_MS=60000
ONBOARDING_TASK_REMINDER_HOURS=24
ONBOARDING_APPROVAL_REMINDER_HOURS=48
ONBOARDING_DOCUMENT_REMINDER_HOURS=48
ONBOARDING_ESCALATION_AFTER_REMINDERS=2
ONBOARDING_DEFAULT_DURATION_DAYS=14
ONBOARDING_ACKNOWLEDGEMENT_VERSION=1.0
ONBOARDING_REQUIRED_EMPLOYEE_FIELDS=employee_no,hire_date,primary_branch_id,primary_department_id,primary_position_id,reports_to,grade_id,cost_center_id,employment_type

DEFAULT_COMPANY_NAME=Alliance Insurance Corporation Limited
PLATFORM_ADMIN_EMAIL=info@example.com
PLATFORM_ADMIN_PHONE=+255700000001
PLATFORM_ADMIN_FIRST_NAME=Platform
PLATFORM_ADMIN_LAST_NAME=Owner
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_USER_NO=OWNER-00001
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_PHONE=
INITIAL_OWNER_FIRST_NAME=
INITIAL_OWNER_LAST_NAME=
INITIAL_OWNER_PASSWORD=
INITIAL_OWNER_USER_NO=
COMPANY_ADMIN_EMAIL=admin@example.com
COMPANY_ADMIN_PHONE=+255700000002
COMPANY_ADMIN_FIRST_NAME=System
COMPANY_ADMIN_LAST_NAME=Administrator
COMPANY_ADMIN_PASSWORD=
COMPANY_ADMIN_USER_NO=ADM-00001

ATTENDANCE_PROCESSING_ENABLED=true
ATTENDANCE_INCREMENTAL_CRON=*/2 * * * *
ATTENDANCE_RECALCULATION_CRON=*/5 * * * *
ATTENDANCE_RAW_EVENT_BATCH_SIZE=500
ATTENDANCE_MOBILE_EVENT_BATCH_SIZE=200
ATTENDANCE_DUPLICATE_PUNCH_SECONDS=60
ATTENDANCE_CALCULATION_VERSION=3
ATTENDANCE_CORRECTION_MAX_AGE_DAYS=30
ATTENDANCE_CORRECTION_FUTURE_DAYS=0
ATTENDANCE_CORRECTION_REQUIRES_MANAGER=true
ATTENDANCE_CORRECTION_REQUIRES_HR=true
ATTENDANCE_PERIOD_AUTO_LOCK_ENABLED=false
ATTENDANCE_PERIOD_AUTO_LOCK_DAY=5
ATTENDANCE_CALCULATION_WINDOW_MINUTES=10
ATTENDANCE_DEVICE_TEST_TIMEOUT_MS=5000
ATTENDANCE_MOBILE_MAX_CLOCK_SKEW_SECONDS=300
ATTENDANCE_MOBILE_REQUIRE_DEVICE_IDENTIFIER=true
ATTENDANCE_MOBILE_CLIENT_REQUEST_TTL_DAYS=90

HIKVISION_DEFAULT_PROTOCOL=http
HIKVISION_DEFAULT_PORT=80
HIKVISION_DEFAULT_TIMEZONE=Africa/Dar_es_Salaam
HIKVISION_REQUEST_TIMEOUT_MS=15000
HIKVISION_ATTENDANCE_SYNC_ATTEMPTS=5
HIKVISION_ATTENDANCE_SYNC_RETRY_DELAY_MS=60000
HIKVISION_DEVICE_OFFLINE_AFTER_FAILURES=3
HIKVISION_DEVICE_CLOCK_DRIFT_WARNING_SECONDS=120
HIKVISION_DEVICE_HEALTH_CRON=*/10 * * * *
HIKVISION_AUTO_SYNC_START_TIME=
HIKVISION_AUTO_SYNC_END_TIME=

REPORT_COMPANY_ID=1
REPORT_RECIPIENT_EMAIL=reports@example.com
REPORT_TIMEZONE=Africa/Dar_es_Salaam
REPORT_EXECUTION_TIME=08:00:00
REPORT_DATE=
REPORT_FALLBACK_TO_LATEST=true
