# =========================================================
# APPLICATION
# =========================================================
NODE_ENV=development
APP_NAME=Alliance HRMS
APP_ENV=development
# When true, API 500 responses include the real server-side error message
# even if APP_ENV=production. Only enable temporarily for troubleshooting -
# it can leak internal details (SQL fragments, file paths) to API clients.
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8888
APP_GLOBAL_PREFIX=api
APP_TIMEZONE=Africa/Dar_es_Salaam

APP_URL=http://localhost:8888
APP_FRONTEND_URL=http://localhost:9991
SUPPORT_EMAIL=support@example.com

# Comma-separated frontend origins
APP_ALLOWED_ORIGINS=http://localhost:9991,http://127.0.0.1:9991

# Enable only when documentation exposure is intentional and protected
APP_ENABLE_API_DOCS=true

# Enable when running behind Nginx or another reverse proxy
APP_TRUST_PROXY=true

TZ=Africa/Dar_es_Salaam
DEFAULT_TIMEZONE=Africa/Dar_es_Salaam

# =========================================================
# FILE STORAGE
# =========================================================
APP_PUBLIC_STORAGE_PATH=uploads
APP_PRIVATE_STORAGE_PATH=private-uploads
MAX_UPLOAD_FILE_SIZE_BYTES=10485760

# =========================================================
# DATABASE
# =========================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-database-password
DB_NAME=hrms_db

DB_SSL_ENABLED=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=15
DB_POOL_MIN=2
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
DB_SLOW_QUERY_MS=2000

# Database maintenance
# Set DB_BACKUP_COMMAND to a full pg_dump path on Windows if pg_dump is not on PATH.
DB_BACKUP_COMMAND=pg_dump
DB_RESTORE_COMMAND=
DB_PSQL_COMMAND=
DB_BACKUP_DIR=backups/database
DB_BACKUP_FORMAT=custom
DB_BACKUP_COMPRESS_LEVEL=9

# =========================================================
# JWT
# =========================================================
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_RESET_SECRET=replace-with-a-long-random-reset-secret
# Legacy compatibility fallback for attendance-device secret derivation.
JWT_SECRET=
JWT_ACCESS_EXPIRATION=20m
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=alliance-hrms
JWT_AUDIENCE=alliance-hrms-web

# =========================================================
# ENCRYPTION
# =========================================================
APP_KEY=replace-with-a-long-random-application-key
TWO_FACTOR_SECRET_KEY=replace-with-a-long-random-2fa-secret
ATTENDANCE_DEVICE_SECRET_KEY=replace-with-a-long-random-device-secret
REPORT_SMTP_SECRET_KEY=replace-with-a-long-random-report-smtp-secret
BIOMETRIC_ENCRYPTION_KEY=replace-with-a-long-random-biometric-secret

# =========================================================
# REDIS
# =========================================================
USE_REDIS=true
REDIS_URL=redis://127.0.0.1:6379
NOTIFICATION_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:9991,http://127.0.0.1:9991

# =========================================================
# HEALTH
# =========================================================
HEALTH_DISK_PATH=.
HEALTH_DISK_MIN_FREE_BYTES=1073741824
HEALTH_EXPOSE_DETAILS=false

# =========================================================
# RATE LIMIT
# =========================================================
THROTTLER_TTL=60000
THROTTLER_LIMIT=100

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=no-reply@example.com
MAIL_PASS=replace-with-smtp-password
MAIL_SECURE=false
MAIL_FROM=no-reply@example.com
MAIL_OVERRIDE_ENABLED=false
MAIL_TEST_TO=test-notifications@example.com
MAIL_TEST_CC=
MAIL_TEST_BCC=
MAIL_OVERRIDE_ADD_ORIGINAL_RECIPIENTS_TO_BODY=true
MAIL_OVERRIDE_SUBJECT_PREFIX=[TEST]

SMS_GATEWAY_ENABLED=false
SMS_GATEWAY_URL=http://your-sms-gateway-host:9090/bulksms
SMS_GATEWAY_USERNAME=replace-with-sms-username
SMS_GATEWAY_PASSWORD=replace-with-sms-password
SMS_GATEWAY_SHORTCODE=ALLIANCE
SMS_GATEWAY_CHANNEL=
SMS_GATEWAY_TIMEOUT_MS=10000

ENABLE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_EXPIRY_HOURS=24
EMPLOYEE_IMPORT_DEFAULT_PASSWORD=
AUTH_REQUIRED_2FA_ROLES=SUPER_ADMIN,PLATFORM_ADMINISTRATOR,COMPANY_ADMIN,HR_MANAGER,IT_ADMIN,AUDITOR

