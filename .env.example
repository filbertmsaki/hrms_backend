COMPANY_ADMIN_PHONE=+255700000002
COMPANY_ADMIN_FIRST_NAME=System
COMPANY_ADMIN_LAST_NAME=Administrator
COMPANY_ADMIN_PASSWORD=Admin123!
COMPANY_ADMIN_USER_NO=ADM-00001

ATTENDANCE_PROCESSING_ENABLED=true
ATTENDANCE_INCREMENTAL_CRON=*/5 * * * *
ATTENDANCE_RECALCULATION_CRON=*/10 * * * *
ATTENDANCE_CALCULATION_WINDOW_MINUTES=10
ATTENDANCE_DEVICE_TEST_TIMEOUT_MS=5000

HIKVISION_DEFAULT_PROTOCOL=http
HIKVISION_DEFAULT_PORT=80
HIKVISION_DEFAULT_TIMEZONE=Africa/Dar_es_Salaam
HIKVISION_REQUEST_TIMEOUT_MS=15000
