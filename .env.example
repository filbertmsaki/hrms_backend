NODE_ENV=development
APP_ENV=development
PORT=8888
APP_URL=http://localhost:8888
APP_FRONTEND_URL=http://localhost:9991
APP_NAME=Alliance HRMS
SUPPORT_EMAIL=support@example.com
TZ=Africa/Dar_es_Salaam
DEFAULT_TIMEZONE=Africa/Dar_es_Salaam

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=hrms_db

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_RESET_SECRET=replace-with-a-long-random-reset-secret
JWT_ACCESS_EXPIRATION=120m
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=hrms
JWT_AUDIENCE=hrms-client
JWT_SECRET=

APP_KEY=replace-with-a-long-random-application-key
TWO_FACTOR_SECRET_KEY=replace-with-a-long-random-2fa-secret
ATTENDANCE_DEVICE_SECRET_KEY=replace-with-a-long-random-device-secret
REPORT_SMTP_SECRET_KEY=replace-with-a-long-random-report-smtp-secret
BIOMETRIC_ENCRYPTION_KEY=replace-with-a-long-random-biometric-secret

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=no-reply@example.com
MAIL_PASS=replace-with-smtp-password
MAIL_SECURE=false
MAIL_FROM=no-reply@example.com
MAIL_OVERRIDE_ENABLED=false
MAIL_TEST_TO=test-notifications@example.com
MAIL_TEST_CC=
MAIL_TEST_BCC=
MAIL_OVERRIDE_ADD_ORIGINAL_RECIPIENTS_TO_BODY=true
MAIL_OVERRIDE_SUBJECT_PREFIX=[TEST]

USE_REDIS=false
REDIS_URL=redis://127.0.0.1:6379
THROTTLER_TTL=60000
THROTTLER_LIMIT=100

ENABLE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_EXPIRY_HOURS=24
EMPLOYEE_IMPORT_DEFAULT_PASSWORD=Employee!123

DEFAULT_COMPANY_NAME=Alliance Insurance Corporation Limited
PLATFORM_ADMIN_EMAIL=info@example.com
PLATFORM_ADMIN_PHONE=+255700000001
PLATFORM_ADMIN_FIRST_NAME=Platform
PLATFORM_ADMIN_LAST_NAME=Owner
PLATFORM_ADMIN_PASSWORD=Owner123!
PLATFORM_ADMIN_USER_NO=OWNER-00001
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_PHONE=
INITIAL_OWNER_FIRST_NAME=
INITIAL_OWNER_LAST_NAME=
INITIAL_OWNER_PASSWORD=
INITIAL_OWNER_USER_NO=
