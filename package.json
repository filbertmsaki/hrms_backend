{
  "name": "nest-auth",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.build.json --noEmit --incremental false",
    "lint:check:files": "node scripts/lint-changed-files.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_ENV=test DEBUG=false USE_REDIS=false DB_NAME=hrms_test_db APP_FRONTEND_URL=http://localhost:9991 node -r dotenv/config ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "typeorm": "ts-node --transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js --dataSource src/database/data-source.ts",
    "migration:generate": "npm run typeorm migration:generate src/database/migrations/Migration && npx ts-node -r tsconfig-paths/register src/database/fix-generated-migration.ts",
    "migration:create": "npm run typeorm migration:create src/database/migrations/EmptyMigration",
    "migration:normalize-metadata": "ts-node -r tsconfig-paths/register src/database/normalize-migration-metadata.ts",
    "migration:run": "npm run typeorm migration:run",
    "migration:revert": "npm run typeorm migration:revert",
    "migration:show": "npm run typeorm migration:show",
    "migration:run:built": "node ./node_modules/typeorm/cli.js -d dist/database/data-source.js migration:run",
    "migration:show:built": "node ./node_modules/typeorm/cli.js -d dist/database/data-source.js migration:show",
    "migration:revert:built": "node ./node_modules/typeorm/cli.js -d dist/database/data-source.js migration:revert",
    "seed:run": "ts-node -r tsconfig-paths/register src/database/seeds/run-seed.ts",
    "seed:run:built": "node dist/database/seeds/run-seed.js",
    "seed:alliance-employees": "ts-node -r tsconfig-paths/register src/database/seeds/run-alliance-employees.ts",
    "seed:alliance-employees:built": "node dist/database/seeds/run-alliance-employees.js",
    "seed:avatars": "ts-node -r tsconfig-paths/register src/database/seeds/run-default-avatars.ts",
    "seed:avatars:built": "node dist/database/seeds/run-default-avatars.js",
    "db:schema:reset": "ts-node -r tsconfig-paths/register src/scripts/reset-database-schema.ts --yes",
    "db:schema:reset:built": "node dist/scripts/reset-database-schema.js --yes",
    "db:backup": "ts-node -r tsconfig-paths/register src/scripts/backup-and-wipe-database.ts --backup-only",
    "db:backup:built": "node dist/scripts/backup-and-wipe-database.js --backup-only",
    "db:reset:fresh": "npm run db:backup && npm run db:schema:reset && npm run migration:run && npm run seed:run",
    "db:reset:fresh:built": "npm run db:backup:built && npm run db:schema:reset:built && npm run migration:run:built && npm run seed:run:built",
    "seed:reset": "npm run db:reset:fresh",
    "db:fresh": "npm run db:reset:fresh",
    "db:reset": "npm run db:reset:fresh",
    "db:restore": "ts-node -r tsconfig-paths/register src/scripts/restore-database-backup.ts",
    "db:restore:latest": "ts-node -r tsconfig-paths/register src/scripts/restore-database-backup.ts --latest",
    "db:restore:dry-run": "ts-node -r tsconfig-paths/register src/scripts/restore-database-backup.ts --latest --dry-run",
    "db:wipe": "ts-node -r tsconfig-paths/register src/scripts/backup-and-wipe-database.ts",
    "db:wipe:dry-run": "ts-node -r tsconfig-paths/register src/scripts/backup-and-wipe-database.ts --dry-run",
    "report:daily:setup-send": "ts-node -r tsconfig-paths/register src/scripts/setup-and-send-daily-attendance-report.ts",
    "validate:push": "node scripts/validate-pre-push.mjs",
    "validate:push:changed": "npm run lint:check:files",
    "validate:push:full": "npm run lint:check && npm run build && npm test -- --runInBand",
    "validate:ci": "npm run lint:check && npm run build && npm test -- --runInBand && npm run test:e2e"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.10",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.10",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.28",
    "@scalar/nestjs-api-reference": "^1.0.31",
    "@types/pdfkit": "^0.17.6",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.78.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "decimal.js": "^10.6.0",
    "digest-fetch": "^3.1.1",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.8.0",
    "helmet": "^8.3.0",
    "nestjs-zod": "^5.1.1",
    "otplib": "^13.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "redis": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "typeorm-extension": "^3.7.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(digest-fetch|md5)/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
